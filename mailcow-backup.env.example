# Copy this file to mailcow-backup.env and adjust values for this host.
# mailcow-backup.env is git-ignored — it's host-specific config, not a secret file
# (there is no password in this setup; auth is an SSH key, see setup-ssh-key.sh).

# --- sftpgo target ---
SFTP_HOST="sftpgo"                 # hostname or IP of the sftpgo server (needs a /etc/hosts entry if not in DNS)
SFTP_PORT="2022"
SFTP_USER="mailcow-backup"
SFTP_TARGET_DIR="/"                # remote folder (relative to the sftpgo user's home/virtual folder)

# --- SSH key auth (see setup-ssh-key.sh) ---
# Leave these as-is unless you want the key stored somewhere else.
SFTP_SSH_KEY_FILE="$CURRENTDIR/.ssh/id_ed25519_mailcow-backup"
SFTP_KNOWN_HOSTS_FILE="$CURRENTDIR/.ssh/known_hosts"

# --- mailcow ---
MAILCOW_SCRIPT="/opt/mailcow-dockerized/helper-scripts/backup_and_restore.sh"
MAILCOW_BACKUP_LOCATION="/opt/backup-mailcow/backups"
BACKUP_RETENTION_DAYS="7"          # passed to mailcow's own --delete-days

# --- housekeeping ---
LOG_RETENTION_DAYS="30"            # local log files older than this are pruned
